# Copy this file to `.env` and fill in your values.
# `.env` is gitignored; `.env.example` is not.

# MiniMax (OpenAI-compatible chat model provider).
# Env-var form follows ASP.NET Core's Section__Key convention.
MiniMax__ApiKey=
MiniMax__Endpoint=https://api.minimaxi.chat/v1
MiniMax__ModelId=MiniMax-M3
