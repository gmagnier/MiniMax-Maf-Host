###############################################################################
################################ Custom config ################################
###############################################################################

[*.cs]
# New line preferences
end_of_line = lf
insert_final_newline = true

# Default scope and severity
dotnet_code_quality.api_surface = all
dotnet_analyzer_diagnostic.severity = warning

dotnet_code_quality.CA1024.api_surface = public, internal

# Disable to match C# coding conventions
# https://learn.microsoft.com/en-us/dotnet/csharp/fundamentals/coding-style/coding-conventions#camel-case
dotnet_naming_rule.private_static_readonly_fields_should_be_pascalcase.severity = none

# CA1707: Identifiers should not contain underscores
dotnet_diagnostic.CA1707.severity = none

# Duplicate with MA0073
# IDE0100: Remove redundant equality
dotnet_diagnostic.IDE0100.severity = none

# Duplicate with RCS1077
# IDE0120: Simplify LINQ expression
dotnet_diagnostic.IDE0120.severity = none

# IDE0161: Namespace declaration preferences
dotnet_diagnostic.IDE0161.severity = error
csharp_style_namespace_declarations = file_scoped:suggestion

# CA1032: Implement standard exception constructors
dotnet_diagnostic.CA1032.severity = suggestion

# CA1036: Override methods on comparable types
dotnet_diagnostic.CA1036.severity = none

# CA1303: Do not pass literals as localized parameters
dotnet_diagnostic.CA1303.severity = none

# Duplicate with CA1309
# [DisabledByDefault] CA1307: Specify StringComparison for clarity
dotnet_diagnostic.CA1307.severity = none

# Duplicate with CA1304
# CA1311: Specify a culture or use an invariant version
dotnet_diagnostic.CA1311.severity = none

# Duplicated with S1144
# CA1823: Avoid unused private fields
dotnet_diagnostic.CA1823.severity = none

# CA1848: Use the LoggerMessage delegates
dotnet_diagnostic.CA1848.severity = none

# IDE0058: Expression value is never used
dotnet_diagnostic.IDE0058.severity = none

# Duplicate with S1144
# IDE0051: Remove unused private members
dotnet_diagnostic.IDE0051.severity = none

# Duplicate with S1144
# IDE0052: Remove unread private members
dotnet_diagnostic.IDE0052.severity = none

# CA1062: Validate arguments of public methods
dotnet_diagnostic.CA1062.severity = none

# IDE0045: Use conditional expression for assignment
dotnet_diagnostic.IDE0045.severity = none

# IDE0046: Use conditional expression for return
dotnet_diagnostic.IDE0046.severity = none

# Duplicated with RCS1019
# IDE0036: Order modifiers
dotnet_diagnostic.IDE0036.severity = none

# Not usefull for ASP.NET Core projects
# https://devblogs.microsoft.com/dotnet/configureawait-faq/#ive-heard-configureawaitfalse-is-no-longer-necessary-in-net-core-true
# CA2007: Do not directly await a Task
dotnet_diagnostic.CA2007.severity = none

# Duplicate with S2629
# CA2254: Template should be a static expression
dotnet_diagnostic.CA2254.severity = none

# Organize usings
dotnet_separate_import_directive_groups = false

# .NET namespace rules
dotnet_style_namespace_match_folder = true

# Use expression body for local functions
csharp_style_expression_bodied_local_functions = when_on_single_line

# CA1707: Identifiers should not contain underscores
dotnet_diagnostic.CA1707.severity = none

# IDE0072: Add missing cases to switch expression
dotnet_diagnostic.IDE0072.severity = suggestion

# SYSLIB1045: Use GeneratedRegexAttribute to generate the regular expression implementation at compile time.
dotnet_diagnostic.SYSLIB1045.severity = suggestion

# Marked as suggestion because it's heavily used in EF queries
# NX0003: Instance of NullForgiving operator in a lambda expression
dotnet_diagnostic.NX0003.severity = suggestion

# S1135: Track uses of "TODO" tags
dotnet_diagnostic.S1135.severity = suggestion

# Not a warning/error because of nullability check misbehavior
# S3267: Loops should be simplified with "LINQ" expressions
dotnet_diagnostic.S3267.severity = suggestion

# S3925: "ISerializable" should be implemented correctly
dotnet_diagnostic.S3925.severity = suggestion

# EF Core do not support IEnumerable.Contains with a comparer
# MA0002: IEqualityComparer<string> or IComparer<string> is missing
dotnet_diagnostic.MA0002.severity = none

# Global regex timeout should be set instead.
# MA0009 : Regular expressions should not be vulnerable to Denial of Service attacks
dotnet_diagnostic.MA0009.severity = none

# Duplicate with CA1012
# MA0017: Abstract types should not have public or internal constructors
dotnet_diagnostic.MA0017.severity = none

# Proposed fix is too complex and may be used without second thought
# MA0031: Optimize Enumerable.Count() usage
dotnet_diagnostic.MA0031.severity = suggestion

# Duplicate with CA2259
# MA0033: Do not tag instance fields with ThreadStaticAttribute
dotnet_diagnostic.MA0033.severity = none

# Duplicate with CA1507
# MA0043: Use nameof operator in ArgumentException
dotnet_diagnostic.MA0043.severity = none

# It requires to have only one type by file
# MA0048: File name must match type name
dotnet_diagnostic.MA0048.severity = error

# Options for MA0051: Method is too long
MA0051.maximum_lines_per_method = 60
MA0051.maximum_statements_per_method = 40
MA0051.skip_local_functions = false

# Duplicate with EX003
# MA0054: Embed the caught exception as innerException
dotnet_diagnostic.MA0054.severity = none

# The alternative is less readable
# MA0098: Use indexer instead of LINQ methods
dotnet_diagnostic.MA0098.severity = none

# Not needed because LF EOL is enforced for all source files regardless of OS
# MA0101: String contains an implicit end of line character
dotnet_diagnostic.MA0101.severity = none

# The alternative is very verbose. To reconsider by creating a helper.
# MA0111: Use string.Create instead of FormattableString
dotnet_diagnostic.MA0111.severity = none

# MA0135: The log parameter has no configured type
dotnet_diagnostic.MA0135.severity = none

# MA0136: Raw String contains an implicit end of line character
dotnet_diagnostic.MA0136.severity = none

# Duplicate with S4261
# [DisabledByDefault] MA0137: Use 'Async' suffix when a method returns an awaitable type
dotnet_diagnostic.MA0137.severity = none

# MA0139: Log parameter type is not valid
dotnet_diagnostic.MA0139.severity = none

# Duplicate rules
# https://github.com/meziantou/Meziantou.Analyzer/blob/2.0.14/docs/comparison-with-other-analyzers.md#microsoftcodeanalysisnetanalyzers
dotnet_diagnostic.MA0001.severity = none
dotnet_diagnostic.MA0005.severity = none
dotnet_diagnostic.MA0011.severity = none
dotnet_diagnostic.MA0012.severity = none
dotnet_diagnostic.MA0013.severity = none
dotnet_diagnostic.MA0015.severity = none
dotnet_diagnostic.MA0018.severity = none
dotnet_diagnostic.MA0020.severity = none
dotnet_diagnostic.MA0027.severity = none
dotnet_diagnostic.MA0028.severity = none
dotnet_diagnostic.MA0036.severity = none
dotnet_diagnostic.MA0038.severity = none
dotnet_diagnostic.MA0039.severity = none
dotnet_diagnostic.MA0041.severity = none
dotnet_diagnostic.MA0047.severity = none
dotnet_diagnostic.MA0049.severity = none
dotnet_diagnostic.MA0056.severity = none
dotnet_diagnostic.MA0057.severity = none
dotnet_diagnostic.MA0058.severity = none
dotnet_diagnostic.MA0059.severity = none
dotnet_diagnostic.MA0062.severity = none
dotnet_diagnostic.MA0069.severity = none
dotnet_diagnostic.MA0072.severity = none
dotnet_diagnostic.MA0082.severity = none
dotnet_diagnostic.MA0086.severity = none
dotnet_diagnostic.MA0095.severity = none
dotnet_diagnostic.MA0097.severity = none

# Undocumented duplicate rules
dotnet_diagnostic.MA0004.severity = none
dotnet_diagnostic.MA0026.severity = none
