[Program.cs]
# CA1812: Avoid uninstantiated internal classes
dotnet_diagnostic.CA1812.severity = none

[*{Endpoint,Request,Response}.cs]
# [DisabledByDefault] CA1034: Nested types should not be visible
dotnet_diagnostic.CA1034.severity = none
# MA0048: File name must match type name
dotnet_diagnostic.MA0048.severity = none

[*Endpoint.cs]
# SA1402: File may only contain a single type
dotnet_diagnostic.SA1402.severity = none

# EF Core migrations
[**/Migrations/*_*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = suggestion
dotnet_diagnostic.RS0030.severity = suggestion
dotnet_diagnostic.S103.severity = suggestion
dotnet_diagnostic.S105.severity = suggestion
dotnet_diagnostic.S1186.severity = none
dotnet_diagnostic.S1192.severity = suggestion
dotnet_diagnostic.S138.severity = suggestion
dotnet_diagnostic.S2333.severity = none
dotnet_diagnostic.S3254.severity = none

[**/*.Tests/**.cs]
dotnet_diagnostic.IDE0039.severity = suggestion

# EF Core use Expression. They don't support many C# constructs so we can't reduce nesting
[**/*Repository*.cs]
dotnet_diagnostic.S3358.severity = suggestion
dotnet_diagnostic.S4058.severity = suggestion

# Verify settings
[*.{received,verified}.*]
charset = "utf-8-bom"
end_of_line = lf
indent_size = unset
indent_style = unset
insert_final_newline = false
tab_width = unset
trim_trailing_whitespace = false
