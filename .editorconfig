# uncomment this config when upgrading to .NET 9
# see https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/style-rules/language-rules#option-format
#dotnet_style_require_accessibility_modifiers = always:error


# RCS1016
roslynator_body_style = block
roslynator_use_block_body_when_declaration_spans_over_multiple_lines = true
# RCS1018
roslynator_accessibility_modifiers = explicit
# RCS1050
roslynator_object_creation_parentheses_style = omit
# RCS1051
roslynator_conditional_operator_condition_parentheses_style = omit_when_condition_is_single_token
# RCS1207
roslynator_use_anonymous_function_or_method_group = method_group
# RCS1090
roslynator_configure_await = false
# RCS1248
roslynator_null_check_style = pattern_matching
# RCS1254
roslynator_enum_flag_value_style = decimal_number
# RCS1014
roslynator_array_creation_type_style = implicit
# RCS1078
roslynator_empty_string_style = field
# RCS1096
roslynator_enum_has_flag_style = method
# RCS1250
roslynator_object_creation_type_style = implicit
# RCS1253
roslynator_doc_comment_summary_style = multi_line
# RCS1252
roslynator_infinite_loop_style = while
# RCS1264: Use 'var' or explicit type
roslynator_use_var = never
# RCS1260: Add/remove trailing comma
roslynator_trailing_comma_style = none

# Duplicate with CA2201
# EX001: Don not use generic exception types
dotnet_diagnostic.EX001.severity = none

############### Rules that are only visible in Visual Studio ###################
# https://github.com/dotnet/roslyn/blob/7fe4f86/src/Analyzers/Core/Analyzers/EnforceOnBuildValues.cs#L119-L128
# IDE0001: Simplify name
dotnet_diagnostic.IDE0001.severity = suggestion
# IDE0002: Simplify member access
dotnet_diagnostic.IDE0002.severity = suggestion
# IDE0003 and IDE0009: this and Me preferences
dotnet_diagnostic.IDE0003.severity = suggestion
dotnet_diagnostic.IDE0009.severity = none
# IDE0035: Remove unreachable code
dotnet_diagnostic.IDE0035.severity = suggestion
# IDE0049: Use language keywords instead of framework type for type references
dotnet_diagnostic.IDE0049.severity = suggestion
# IDE0050: Convert anonymous type to tuple
dotnet_diagnostic.IDE0050.severity = suggestion
# IDE0079: emove unnecessary suppression
dotnet_diagnostic.IDE0079.severity = suggestion

# Same observed behavior for IDE0053 even if it's not listed in the link above
# IDE0053: Use expression body for lambdas
dotnet_diagnostic.IDE0053.severity = suggestion
