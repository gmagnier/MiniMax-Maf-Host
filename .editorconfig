# NX0001: Null-forgiving operator without justification. We use `!` legitimately
# at file/path boundaries (File.ReadAllText on confirmed-existing files,
# Process.Start returning Task we await, Path.GetDirectoryName on a known-valid
# path). The justification noise outweighs the benefit for top-level scripts
# like Program.cs.
dotnet_diagnostic.NX0001.severity = none

# ---- Project-local suppressions added for this codebase ----
# These rules are technically valid but produce too much noise on our
# top-level statements and MCP-tools classes. Loosen per-rule below.

# SA1200: Using directive should appear within a namespace declaration.
# False positive on top-level statements (Program.cs) where no namespace is
# allowed, and on files that intentionally hoist usings to reduce nesting.
dotnet_diagnostic.SA1200.severity = none

# SA1512 / SA1501 / SA1107: Single-line comment + blank / Statement should not
# be on a single line / Multiple statements on one line. Pure formatting, no
# semantic value. Style preferences belong in editor settings, not the build.
dotnet_diagnostic.SA1512.severity = none
dotnet_diagnostic.SA1501.severity = none
dotnet_diagnostic.SA1107.severity = none

# SA1116: Parameters should begin on a new line when split. We allow
# call-sites that fit on one line. Pure formatting.
dotnet_diagnostic.SA1116.severity = none

# SA1000 / SA1516: 'new' spacing / elements should be separated by blank line.
# Pure formatting.
dotnet_diagnostic.SA1000.severity = none
dotnet_diagnostic.SA1516.severity = none

# SA1204 / SA1101: Static-before-non-static ordering / 'this.' prefix.
# We don't follow these ordering conventions.
dotnet_diagnostic.SA1204.severity = none
dotnet_diagnostic.SA1101.severity = none

# IDE1006: Naming style violation (const/field naming). We use PascalCase
# constants at file scope (e.g. LeadName, SpecName). Re-enable per-namespace
# once we adopt scoped style.
dotnet_diagnostic.IDE1006.severity = none

# IDE0130: Namespace does not match folder structure. Tools/ is a logical
# folder for code organized by purpose; Tools/DashboardTools.cs uses namespace
# MafMiniMaxAgent.Mcp. Re-enable per-folder if we add nested sub-folders.
dotnet_diagnostic.IDE0130.severity = none

# MA0016: Prefer IList<T> over List<T> in public APIs. Applies to JSON
# response types that are serialized by System.Text.Json and re-bound by
# the MCP client; List<T> is fine for that scenario.
dotnet_diagnostic.MA0016.severity = none

# MA0076: Implicit culture-sensitive ToString in $"...". We use Invariant
# everywhere by default; MA0076 trips on interpolation log calls where we
# intentionally want the current culture (UX strings). Trust the dev.
dotnet_diagnostic.MA0076.severity = none

# RCS1021: Use expression-bodied lambda. We prefer block-bodied for multi-statement
# lambdas.
dotnet_diagnostic.RCS1021.severity = none

# IDE0290: Use primary constructor. We prefer explicit constructors when
# the class has a logger + http client pair, for readability.
dotnet_diagnostic.IDE0290.severity = none

# S4487: Remove unread private field. We keep _log for future observability
# hooks (audit, structured logging, etc.).
dotnet_diagnostic.S4487.severity = none

# S3358: Extract nested ternary into independent statements. We accept
# short ternaries in switch expressions for readability.
dotnet_diagnostic.S3358.severity = none

# IDE0005: Unused using. The IDE0005 analyzer has two modes:
#   (a) when GenerateDocumentationFile=true, it surfaces unused usings;
#   (b) when GenerateDocumentationFile=false, it is implicit and ignored.
# We are in mode (b) by default. No suppression needed here; the IDE may
# still flag unused usings as IDE hints, not errors.
# (placeholder kept for documentation; no rule set here)

# SA1629: Documentation text should end with a period. We allow terse
# summaries on Program.cs.
dotnet_diagnostic.SA1629.severity = none

# End project-local suppressions.

