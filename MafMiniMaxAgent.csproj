<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>564916ae-c594-4d54-8d45-7e572406cf2c</UserSecretsId>

    <!-- Treat warnings as errors so analyzer violations break the build.
         Loosen per-rule in .editorconfig if a rule is too noisy. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- StyleCop is intentionally noisy out of the box; suppress rules
         selectively in .editorconfig as needed (e.g. SA0001, SA1633, SA1652).
         Note: severity = none for dotnet_diagnostic.* rules works; for SA*
         analyzers we use #pragma warning disable SA1xxx.
         SA1201, SA1202, SA1214, SA1215 are also added to NoWarn below to
         prevent StyleCop 1.1.118 from crashing (KeyNotFoundException on
         RecordDeclaration) before the suppression can apply. -->
    <NoWarn>SA0001;SA1201;SA1202;SA1214;SA1215;IDE0005</NoWarn>

    <!-- All analyzers run as part of build. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- GenerateDocumentationFile is OFF for now. Most public members are MCP
         DTOs and tool wrappers that the MCP client never documents; turning
         this on produces ~80 CS1591 warnings. Re-enable and add XML docs
         per-file once we want to publish this assembly as a library. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    All Package versions live in Directory.Packages.props (Central Package
    Management). Do NOT add Version= here. To add a new package: add a
    matching <PackageVersion> in Directory.Packages.props, then reference
    the package by name only below.
  -->
  <ItemGroup>
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" />
    <PackageReference Include="Microsoft.Agents.AI.DevUI" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
  </ItemGroup>

  <!--
    GlobalPackageReference applies the analyzer to every .csproj in the
    solution. Analyzers are NOT covered by Central Package Management, so
    each one carries an explicit Version= here. To upgrade, edit this list
    (and update Directory.Packages.props only for non-analyzer packages).
  -->
  <ItemGroup>
    <GlobalPackageReference Include="Nullable.Extended.Analyzer" Version="1.16.6891" />
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.290" />
    <!-- BannedApiAnalyzers 5.6.0 requires Roslyn 4.12 (shipped in .NET 9+). -->
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.1.118" />
    <GlobalPackageReference Include="Roslynator.Analyzers" Version="5.0.0" />
    <GlobalPackageReference Include="SmartanAlyzers.ExceptionAnalyzer" Version="1.0.10" />
  </ItemGroup>

</Project>
